{
  "llm": {
    "models": [
      {
        "id": "main-model",
        "model": "deepseek-v4-flash",
        "context_window": 1000000,
        "max_output_tokens": 65536,
        "base_url": "https://api.deepseek.com",
        "api_key": ""
      }
    ],
    "main_model_id": "main-model",
    "vision": {
      "enabled": false
    }
  },
  "tools": {
    "list_skills": {
      "enabled": true,
      "run_scoped": false
    },
    "read_skill": {
      "enabled": true,
      "run_scoped": false
    },
    "web_search": {
      "enabled": true,
      "run_scoped": true
    },
    "create_file": {
      "enabled": true,
      "run_scoped": true
    },
    "file_read": {
      "enabled": true,
      "run_scoped": true
    },
    "read_context_segment": {
      "enabled": true,
      "run_scoped": true
    },
    "terminal_run": {
      "enabled": true,
      "run_scoped": true
    },
    "web_instance": {
      "enabled": true,
      "run_scoped": true
    }
  },
  "model": {
    "stream": true,
    "reasoning_summary": false
  },
  "tool_timeout": {
    "default_seconds": 120.0,
    "max_seconds": 1800.0
  },
  "context": {
    "enabled": true,
    "max_input_tokens": 65536,
    "compression_trigger_ratio": 0.8,
    "keep_recent_items": 12,
    "summary_max_tokens": 4096,
    "summary_input_tokens": 8192,
    "summary_model_id": "",
    "compression_timeout_seconds": 120.0,
    "local_compression": {
      "enabled": false,
      "python": "compression/.venv/Scripts/python.exe",
      "model": "microsoft/llmlingua-2-xlm-roberta-large-meetingbank",
      "device": "cuda",
      "rate": 0.7
    }
  }
}
